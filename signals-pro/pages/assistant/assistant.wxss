/* ============ 第三级：全屏 AI 助教问答平台 ============ */

.full {
  display: flex;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}

/* 全屏页不吃全局 .page 的内边距（否则底部会多出 160rpx 空白） */
.page.full {
  padding: 0;
  min-height: 0;
}

/* ---------- 侧边栏 ---------- */
.side-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 20, 12, 0.3);
  z-index: 55;
}

.side {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 272px;
  background: var(--surface);
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.24s cubic-bezier(0.22, 0.8, 0.3, 1);
  z-index: 60;
}

.side.on {
  transform: translateX(0);
}

.side-top {
  padding: 14px 14px 10px;
  border-bottom: 1px solid var(--line);
  flex-shrink: 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 9px;
}

.brand-av {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  background: linear-gradient(150deg, #eaf6ff, #d6ebfd);
  flex-shrink: 0;
  box-shadow: 0 4px 10px rgba(61, 134, 212, 0.18);
}

.brand-meta {
  min-width: 0;
}

.brand-n {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.brand-s {
  font-size: 10.5px;
  color: var(--ink-3);
  margin-top: 1px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 170px;
}

.new-btn {
  margin-top: 12px;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 10px;
  padding: 9px 0;
}

.new-btn:active {
  background: #ffd7c7;
}

.side-scroll {
  flex: 1;
  height: 0;
  padding: 0 10px;
  box-sizing: border-box;
}

.side-h {
  font-size: 10.5px;
  color: var(--ink-3);
  letter-spacing: 0.6px;
  padding: 12px 4px 6px;
}

.side-h.mt24 {
  margin-top: 8px;
}

.side-empty {
  font-size: 11.5px;
  color: var(--ink-3);
  padding: 6px 4px 12px;
  line-height: 1.6;
}

.sess {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 9px 10px;
  border-radius: 10px;
  margin-bottom: 4px;
}

.sess.on {
  background: var(--surface-2);
}

.sess-main {
  flex: 1;
  min-width: 0;
}

.sess-t {
  display: block;
  font-size: 12.5px;
  color: var(--ink);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sess-m {
  display: block;
  font-size: 10px;
  color: var(--ink-3);
  margin-top: 2px;
}

.sess-del {
  font-size: 11px;
  color: var(--ink-3);
  padding: 2px 5px;
  flex-shrink: 0;
}

.sess-del:active {
  color: #e05536;
}

.hard {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  padding: 8px 8px;
  border-radius: 9px;
  margin-bottom: 3px;
}

.hard:active {
  background: var(--surface-2);
}

.hard-ch {
  font-size: 9.5px;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 5px;
  padding: 2px 5px;
  flex-shrink: 0;
  margin-top: 1px;
  white-space: nowrap;
}

.hard-t {
  flex: 1;
  font-size: 12px;
  color: var(--ink-2);
  line-height: 1.45;
}

.side-foot {
  flex-shrink: 0;
  border-top: 1px solid var(--line);
  padding: 11px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sf-l {
  min-width: 0;
}

.sf-k {
  display: block;
  font-size: 12px;
  color: var(--ink);
  font-weight: 600;
}

.sf-v {
  display: block;
  font-size: 10px;
  color: var(--ink-3);
  margin-top: 1px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 190px;
}

.sf-go {
  color: var(--ink-3);
  font-size: 18px;
}

/* ---------- 主区 ---------- */
.main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
}

.tb-left {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
  flex: 1;
}

/* 自定义导航栏没有系统返回键，这里给一个明确的返回 */
.tb-back {
  width: 34px;
  height: 32px;
  border-radius: 9px;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tb-back-hv {
  background: var(--primary);
}

.tb-back-hv .tb-back-ico {
  color: #fff;
}

.tb-back-ico {
  font-size: 24px;
  line-height: 1;
  font-weight: 600;
  margin-top: -3px;
}

.tb-icon {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tb-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
}

.tbt {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tbs {
  display: block;
  font-size: 10.5px;
  color: var(--ink-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tb-right {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.tb-styles {
  display: flex;
  background: var(--surface-2);
  border-radius: 9px;
  padding: 2px;
  gap: 1px;
}

.ts {
  width: 27px;
  height: 26px;
  border-radius: 7px;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ts.on {
  background: var(--surface);
  box-shadow: 0 2px 6px rgba(120, 84, 60, 0.14);
}

.tb-btn {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tb-btn:active {
  background: var(--primary-soft);
  color: var(--primary);
}

/* ---------- 对话区 ---------- */
.chat {
  flex: 1;
  height: 0;
  padding: 14px 14px 0;
  box-sizing: border-box;
}

.hero {
  padding: 26px 0 10px;
  max-width: 700px;
}

.hero-av {
  width: 66px;
  height: 66px;
  border-radius: 20px;
  background: linear-gradient(150deg, #eaf6ff, #d6ebfd);
  box-shadow: 0 8px 20px rgba(61, 134, 212, 0.2);
}

.hero-t {
  font-size: 21px;
  font-weight: 700;
  color: var(--ink);
  margin-top: 14px;
  letter-spacing: 0.3px;
}

.hero-s {
  font-size: 13px;
  color: var(--ink-2);
  line-height: 1.7;
  margin-top: 7px;
  max-width: 520px;
}

.guides {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 18px;
}

.guide {
  width: 47%;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 12px 13px;
  box-sizing: border-box;
  box-shadow: var(--shadow);
}

.guide:active {
  border-color: var(--primary);
  background: var(--primary-soft);
}

.g-i {
  font-size: 17px;
}

.g-t {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  margin-top: 5px;
}

.g-d {
  display: block;
  font-size: 11px;
  color: var(--ink-3);
  line-height: 1.55;
  margin-top: 3px;
}

.hero-chips {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 16px;
  max-width: 520px;
}

.chip {
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 10px 12px;
  font-size: 12.5px;
  color: var(--ink-2);
  line-height: 1.45;
}

.chip:active {
  background: var(--primary-soft);
  border-color: #f8c3b0;
}

.msg {
  display: flex;
  gap: 9px;
  margin-bottom: 18px;
  max-width: 820px;
}

.msg.user {
  justify-content: flex-end;
  margin-left: auto;
}

.msg-av {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: linear-gradient(150deg, #eaf6ff, #d6ebfd);
  flex-shrink: 0;
  margin-top: 2px;
}

.msg-body {
  max-width: 86%;
  min-width: 0;
}

.msg.user .msg-body {
  background: linear-gradient(135deg, #f2694b, #ff8d6e);
  color: #fff;
  border-radius: 16px 16px 5px 16px;
  padding: 10px 14px;
  box-shadow: 0 5px 14px rgba(242, 105, 75, 0.22);
}

.msg-text {
  font-size: 14px;
  line-height: 1.65;
  color: #fff;
  word-break: break-word;
}

.msg.assistant .msg-body {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 5px 16px 16px 16px;
  padding: 13px 15px;
  box-shadow: var(--shadow);
}

.blk-p {
  display: block;
  font-size: 14px;
  line-height: 1.75;
  color: var(--ink);
  margin-bottom: 9px;
}

.blk-step {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
}

.st-i {
  width: 18px;
  height: 18px;
  border-radius: 6px;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 11px;
  font-weight: 700;
  text-align: center;
  line-height: 18px;
  flex-shrink: 0;
  margin-top: 2px;
}

.st-t {
  flex: 1;
  font-size: 13.5px;
  line-height: 1.7;
  color: var(--ink-2);
  word-break: break-word;
}

.blk-quote {
  border-left: 3px solid var(--butter);
  background: var(--butter-soft);
  padding: 9px 11px;
  border-radius: 0 9px 9px 0;
  font-size: 13px;
  color: #6b543f;
  margin-bottom: 9px;
  line-height: 1.62;
}

.blk-ans {
  background: var(--mint-soft);
  border: 1px solid #c6ebd6;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 13.5px;
  color: #2b6b48;
  line-height: 1.62;
  margin-bottom: 9px;
  font-weight: 500;
}

.blk-tip {
  background: var(--butter-soft);
  border: 1px dashed #f0d9a8;
  border-radius: 10px;
  padding: 9px 11px;
  font-size: 12.5px;
  color: #8a6a2e;
  line-height: 1.62;
  margin-bottom: 9px;
}

.blk-code {
  background: #1b2733;
  border-radius: 11px;
  overflow: hidden;
  margin-bottom: 10px;
}

.code-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 11px;
  background: #16202a;
}

.code-lang {
  font-size: 10.5px;
  color: #7fa7c9;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.code-copy {
  font-size: 10.5px;
  color: #4de1c1;
  padding: 2px 9px;
  border-radius: 5px;
  background: rgba(77, 225, 193, 0.12);
}

.code-txt {
  display: block;
  padding: 11px;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 11.5px;
  line-height: 1.7;
  color: #cfe3f2;
  white-space: pre-wrap;
  word-break: break-all;
}

.blk-fm {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 9px 11px;
  margin-bottom: 10px;
  overflow-x: auto;
}

.fm-row {
  padding: 3px 0;
}

.refs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px dashed var(--line);
}

.ref {
  font-size: 12px;
  padding: 6px 11px;
  border-radius: 9px;
  background: var(--blue-soft);
  color: #3d78b8;
  border: 1px solid #d8e8f7;
}

.ref:active {
  background: #dcecfb;
}

.typing {
  font-size: 12px;
  color: var(--ink-3);
  padding: 2px 0 14px 39px;
}

.chat-pad {
  height: 18px;
}

/* ---------- 输入台 ---------- */
.composer {
  flex-shrink: 0;
  border-top: 1px solid var(--line);
  background: var(--surface);
  padding-bottom: 8px;
}

.symbar {
  white-space: nowrap;
  padding: 8px 12px 4px;
}

.sym {
  display: inline-block;
  padding: 4px 10px;
  margin-right: 6px;
  border-radius: 8px;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 11.5px;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.sym:active {
  background: var(--primary-soft);
  color: var(--primary);
}

.composer-row {
  display: flex;
  align-items: flex-end;
  gap: 9px;
  padding: 4px 12px 2px;
}

.ta {
  flex: 1;
  min-height: 44px;
  max-height: 130px;
  background: var(--surface-2);
  border-radius: 13px;
  padding: 11px 13px;
  font-size: 14px;
  line-height: 1.5;
  color: var(--ink);
  box-sizing: border-box;
  width: auto;
}

.ta-ph {
  color: var(--ink-3);
  font-size: 13px;
}

.send {
  flex-shrink: 0;
  height: 40px;
  padding: 0 18px;
  border-radius: 13px;
  background: var(--surface-3);
  color: var(--ink-3);
  font-size: 13.5px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2px;
}

.send.on {
  background: linear-gradient(135deg, #f2694b, #ff8d6e);
  color: #fff;
  box-shadow: 0 5px 14px rgba(242, 105, 75, 0.3);
}

.composer-tip {
  text-align: center;
  font-size: 10px;
  color: var(--ink-3);
  padding-top: 5px;
}

/* ---------- 自定义模型弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 20, 12, 0.34);
  z-index: 800;
}

.api-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface);
  border-radius: 22px 22px 0 0;
  padding: 16px 18px 22px;
  z-index: 810;
  max-height: 82vh;
  overflow-y: auto;
  animation: sheet-up 0.24s cubic-bezier(0.22, 0.8, 0.3, 1);
}

@keyframes sheet-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@media (min-width: 700px) {
  .api-sheet {
    left: 50%;
    bottom: 50%;
    right: auto;
    width: 440px;
    border-radius: 18px;
    transform: translate(-50%, 50%);
    animation: none;
  }
}

.as-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.as-t {
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
}

.as-x {
  font-size: 15px;
  color: var(--ink-3);
  padding: 4px 8px;
}

.as-body {
  padding-top: 4px;
}

.as-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
}

.as-row.col {
  display: block;
}

.as-k {
  font-size: 13px;
  color: var(--ink-2);
  font-weight: 600;
}

.as-in {
  width: 100%;
  margin-top: 7px;
  background: var(--surface-2);
  border-radius: 10px;
  padding: 8px 11px;
  font-size: 13px;
  color: var(--ink);
  box-sizing: border-box;
}

.as-ph {
  color: var(--ink-3);
  font-size: 12px;
}

.as-note {
  font-size: 11.5px;
  color: var(--ink-3);
  line-height: 1.65;
  margin-top: 12px;
  background: var(--surface-2);
  border-radius: 10px;
  padding: 10px 12px;
}

.as-note.warn {
  margin-top: 8px;
  background: var(--butter-soft);
  color: #8a6a2e;
}

/* 自检结果：绿色=连通，红字=说清哪儿不对 */
.as-test {
  margin-top: 10px;
  padding: 9px 12px;
  border-radius: 10px;
  background: var(--surface-2);
}

.as-test-t {
  font-size: 11.5px;
  line-height: 1.5;
  word-break: break-all;
}

.as-test-t.ok {
  color: var(--primary);
  font-weight: 600;
}

.as-test-t.bad {
  color: #c0392b;
}

.as-btns {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.as-btns .btn-block {
  flex: 1;
}

/* ---------- 宽屏 ---------- */
@media (min-width: 700px) {
  .side {
    position: relative;
    transform: none;
    width: 268px;
    flex-shrink: 0;
  }

  .side-mask {
    display: none;
  }

  .tb-icon {
    display: none;
  }

  .guide {
    width: 23.5%;
  }

  .chat {
    padding: 18px 26px 0;
  }

  .composer {
    padding: 0 26px 10px;
  }

  .msg-body {
    max-width: 72%;
  }
}

/* 窄屏（360~400px）：压缩右侧控件，保证返回/收缩按钮不被挤出屏幕 */
@media (max-width: 400px) {
  .topbar {
    padding-left: 9px;
    padding-right: 9px;
  }

  .tb-back {
    width: 30px;
  }

  .ts {
    width: 24px;
    height: 24px;
    font-size: 12px;
  }

  .tb-btn {
    width: 28px;
    height: 28px;
    font-size: 12px;
  }

  .tb-left {
    gap: 6px;
  }

  .tb-styles {
    gap: 0;
  }
}

/* ---------- 空态：3 张典型考题 ---------- */
.hero-papers {
  margin-top: 18px;
  max-width: 520px;
}

.hp-h {
  font-size: 12px;
  color: var(--ink-3);
  margin-bottom: 9px;
}

.hp-row {
  display: flex;
  gap: 10px;
}

.hp {
  flex: 1;
  min-width: 0;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 13px;
  overflow: hidden;
}

.hp:active {
  border-color: var(--primary);
}

.hp-img {
  width: 100%;
  height: 96px;
  display: block;
  background: var(--surface-2);
}

.hp-t {
  display: block;
  font-size: 11.5px;
  color: var(--ink-2);
  text-align: center;
  padding: 6px 2px 7px;
}

/* ---------- 图片消息 ---------- */
.msg-img {
  width: 200px;
  height: 268px;
  border-radius: 11px;
  display: block;
  margin-bottom: 7px;
  background: var(--surface-2);
}

/* ---------- 流式光标 ---------- */
.caret {
  color: var(--primary);
  font-size: 13px;
}

/* ---------- 相机按钮 ---------- */
.cam {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 13px;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  margin-bottom: 2px;
}

.cam:active {
  background: var(--primary-soft);
}

@media (max-width: 400px) {
  .msg-img {
    width: 168px;
    height: 224px;
  }
  .hp-img {
    height: 78px;
  }
}
