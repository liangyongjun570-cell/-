<view class="page {{theme}}">
  <!-- 跨 tab 跳进来的来源提示：switchTab 没有返回栈，这里补一条可点的回路 -->
  <view class="back-bar" wx:if="{{back}}" bindtap="goBackTab">
    <text class="bb-arrow">‹</text>
    <text class="bb-t">返回{{back.label}}</text>
    <text class="bb-hint" wx:if="{{back.hint}}">{{back.hint}}</text>
  </view>

  <view class="head">
    <view class="grow">
      <view class="h1">章节目录</view>
      <view class="sub mt8">ch0 – ch7 · {{totalTopics}} 个专题 · {{totalFormulas}} 条公式</view>
    </view>
    <view class="head-search" bindtap="goSearch">⌕</view>
  </view>

  <!-- 总览 -->
  <view class="card ov">
    <view class="row between">
      <view class="grow">
        <view class="muted">全课程进度</view>
        <view class="row middle mt8">
          <text class="ov-num">{{overall.percent}}</text>
          <text class="ov-pct">%</text>
          <text class="ov-sub">{{overall.done}} / {{overall.total}} 单元</text>
        </view>
      </view>
      <view class="ov-badge">{{overall.chaptersDone}}/8 章完成</view>
    </view>
    <view class="bars mt20">
      <view class="bar-item" wx:for="{{list}}" wx:key="id">
        <view class="bar-track">
          <view class="bar-fill bf-{{item.color}}" style="height: {{item.percent}}%"></view>
        </view>
        <text class="bar-l">{{item.num}}</text>
      </view>
    </view>
  </view>

  <!-- 筛选 -->
  <view class="row wrap filters">
    <view
      class="chip f-chip {{filter === item.k ? 'chip-on' : ''}}"
      wx:for="{{filters}}"
      wx:key="k"
      bindtap="setFilter"
      data-k="{{item.k}}"
    >{{item.t}} {{item.n}}</view>
  </view>

  <!-- 章节列表 -->
  <view class="list">
    <block wx:for="{{list}}" wx:key="id">
      <view
        wx:if="{{filter === 'all' || filter === item.state}}"
        class="ch-card card press"
        bindtap="openChapter"
        data-id="{{item.id}}"
      >
        <view class="row">
          <image class="ch-sticker" src="/assets/theme/{{item.sticker}}.jpg" mode="aspectFill" />
          <view class="grow">
            <view class="row middle">
              <text class="ch-num cn-{{item.color}}">ch{{item.num}}</text>
              <text class="ch-name ellipsis">{{item.name}}</text>
              <text wx:if="{{item.state === 'done'}}" class="ch-flag done">已完成</text>
              <text wx:elif="{{item.state === 'doing'}}" class="ch-flag doing">进行中</text>
            </view>
            <view class="muted mt8 ellipsis">{{item.tagline}}</view>
            <view class="row mt12 meta">
              <text class="meta-i">{{item.topicCount}} 专题</text>
              <text wx:if="{{item.formulaCount}}" class="meta-i">{{item.formulaCount}} 公式</text>
              <text wx:if="{{item.exampleCount}}" class="meta-i">{{item.exampleCount}} 例题</text>
              <text class="meta-i">{{item.minutes}} 分钟</text>
            </view>
          </view>
        </view>

        <view class="row middle mt20">
          <view class="progress grow">
            <view class="progress-fill" style="width: {{item.percent}}%"></view>
          </view>
          <text class="ch-pct">{{item.done}}/{{item.total}}</text>
        </view>

        <view class="row between mt16">
          <text class="muted">{{item.percent}}% 已完成</text>
          <view class="ch-go" catchtap="jumpNext" data-id="{{item.id}}">
            {{item.state === 'todo' ? '开始学习' : item.state === 'done' ? '复习' : '继续'}} →
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="lab-tip card-soft mt24" bindtap="goLab">
    <view class="grow">
      <view class="h3">看完想动手？</view>
      <view class="muted mt8">4 个交互实验：卷积扫描、谐波合成、零极点、采样混叠</view>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="footer-tip">按 ch0 概述 → ch1 概念 → ch2 时域 → ch3 卷积 → ch4 级数 → ch5 变换 → ch6 频域 → ch7 复频域 的顺序学最顺</view>
  <view class="safe-bottom"></view>
</view>

<!-- 三级联动智能助教：桌宠悬挂 ⇄ 半屏伴读 ⇄ 全屏问答平台 -->
<assistant />
