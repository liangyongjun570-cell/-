<view class="page no-tab {{theme}}">
  <!-- 章节头 -->
  <view class="hero card">
    <view class="row">
      <image class="hero-img" src="/assets/theme/{{ch.sticker}}.jpg" mode="aspectFill" />
      <view class="grow">
        <view class="row middle">
          <text class="hero-num hn-{{ch.color}}">ch{{ch.num}}</text>
          <text class="hero-name">{{ch.name}}</text>
        </view>
        <view class="muted mt8 ellipsis">{{ch.en}}</view>
        <view class="hero-tag mt12">{{ch.tagline}}</view>
      </view>
    </view>

    <view class="row middle mt24">
      <view class="progress grow">
        <view class="progress-fill" style="width: {{progress.percent}}%"></view>
      </view>
      <text class="hero-pct">{{progress.done}}/{{progress.total}}</text>
    </view>

    <view class="hero-meta mt16">
      <view class="hm">
        <text class="hm-n">{{topics.length}}</text>
        <text class="hm-l">专题</text>
      </view>
      <view class="hm">
        <text class="hm-n">{{formulas.length}}</text>
        <text class="hm-l">公式</text>
      </view>
      <view class="hm">
        <text class="hm-n">{{examples.length}}</text>
        <text class="hm-l">例题</text>
      </view>
      <view class="hm">
        <text class="hm-n">{{ch.minutes}}</text>
        <text class="hm-l">分钟</text>
      </view>
    </view>
  </view>

  <!-- Tab -->
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view
      class="tab {{tab === item.k ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="k"
      bindtap="setTab"
      data-k="{{item.k}}"
    >{{item.t}}</view>
  </scroll-view>

  <!-- 概览 -->
  <block wx:if="{{tab === 'overview'}}">
    <view class="card mt20">
      <view class="h3">本章讲什么</view>
      <view class="sub mt12">{{ch.summary}}</view>
    </view>

    <!-- ch0 三栏式 -->
    <block wx:if="{{isCh0}}">
      <view class="three mt20">
        <view class="tcol" wx:for="{{threeCols}}" wx:key="k">
          <view class="tcol-head tc-{{item.k}}">{{item.t}}</view>
          <view class="tcol-sub">{{item.d}}</view>
          <view
            class="tcol-item"
            wx:for="{{item.items}}"
            wx:for-item="n"
            wx:key="id"
            bindtap="tapThree"
            data-id="{{n.id}}"
          >
            <text class="tci-t">{{n.abbr || n.title || n.name}}</text>
            <text class="tci-s">{{n.abbr ? n.name : ('例' + n.no)}}</text>
          </view>
        </view>
      </view>
      <view class="muted tc-tip">三栏同看：同一道题，从"变换""分析""例题"三个入口都能进。</view>
    </block>

    <!-- 学习目标 -->
    <view class="card mt20">
      <view class="h3">学完能做什么</view>
      <view class="goal" wx:for="{{ch.goals}}" wx:key="*this">
        <text class="goal-i">{{index + 1}}</text>
        <text class="goal-t">{{item}}</text>
      </view>
    </view>

    <!-- 要点 -->
    <view class="card mt20">
      <view class="h3">必记要点</view>
      <view class="kp" wx:for="{{ch.keyPoints}}" wx:key="*this">
        <text class="kp-dot"></text>
        <text class="kp-t">{{item}}</text>
      </view>
    </view>

    <!-- 知识地图 -->
    <view class="card mt20">
      <view class="h3">知识地图</view>
      <view class="mm" wx:for="{{ch.mindmap}}" wx:key="t">
        <view class="mm-t">{{item.t}}</view>
        <view class="row wrap mm-items">
          <text class="mm-i" wx:for="{{item.items}}" wx:for-item="n" wx:key="*this">{{n}}</text>
        </view>
      </view>
    </view>

    <view class="row gap16 mt24">
      <view class="btn btn-soft grow" bindtap="goLab">去实验室</view>
      <view class="btn btn-primary grow" bindtap="goQuiz">本章自测</view>
    </view>

    <!-- 上下章 -->
    <view class="nav-row mt24">
      <view class="nav-card" wx:if="{{prev}}" bindtap="goChapter" data-id="{{prev.id}}">
        <view class="muted">上一章</view>
        <view class="nav-t">ch{{prev.num}} {{prev.name}}</view>
      </view>
      <view class="grow" wx:else></view>
      <view class="nav-card right" wx:if="{{next}}" bindtap="goChapter" data-id="{{next.id}}">
        <view class="muted">下一章</view>
        <view class="nav-t">ch{{next.num}} {{next.name}}</view>
      </view>
    </view>
  </block>

  <!-- 知识专题 -->
  <block wx:if="{{tab === 'topics'}}">
    <view
      class="tp card press"
      wx:for="{{topics}}"
      wx:key="id"
      bindtap="openTopic"
      data-id="{{item.id}}"
    >
      <view class="row between">
        <view class="grow">
          <view class="row middle">
            <text class="tp-name ellipsis">{{item.name}}</text>
            <text wx:if="{{item.learned}}" class="tp-done">已学</text>
          </view>
          <view class="muted mt8">{{item.short}} · {{item.minutes}} 分钟</view>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="tp-intro clamp2 mt12">{{item.intro}}</view>
      <view class="row mt12 gap12">
        <text class="tag tag-coral" wx:if="{{item.formulaCount}}">{{item.formulaCount}} 条公式</text>
        <text class="tag tag-blue">例题讲解</text>
        <text class="tag tag-mint">随堂自测</text>
      </view>
    </view>
    <view class="btn btn-primary btn-block mt24" bindtap="goQuiz">做本章专项题</view>
  </block>

  <!-- 本章公式 -->
  <block wx:if="{{tab === 'formulas'}}">
    <view class="card" wx:if="{{formulas.length}}">
      <view
        class="fm"
        wx:for="{{formulas}}"
        wx:key="id"
        bindtap="openFormula"
        data-id="{{item.id}}"
      >
        <view class="row between">
          <view class="row middle grow">
            <text class="fm-name ellipsis">{{item.name}}</text>
            <text class="tag tag-blue ml8">{{item.cat}}</text>
          </view>
          <text wx:if="{{item.learned}}" class="fm-done">✓</text>
        </view>
        <view class="fm-math">
          <math src="{{item.math}}" size="{{32}}" />
        </view>
      </view>
    </view>
    <view class="card empty" wx:else>
      <image class="empty-img" src="/assets/theme/s22.jpg" mode="aspectFit" />
      <view class="sub">本章没有独立公式条目</view>
      <view class="muted mt8">公式分布在 ch0 概述与后续章节中</view>
    </view>
  </block>

  <!-- 例题自测 -->
  <block wx:if="{{tab === 'practice'}}">
    <block wx:if="{{examples.length}}">
      <view
        class="ex card press"
        wx:for="{{examples}}"
        wx:key="id"
        bindtap="openExample"
        data-id="{{item.id}}"
      >
        <view class="row middle">
          <text class="ex-no">例 {{item.no}}</text>
          <text class="ex-title ellipsis">{{item.title}}</text>
          <text wx:if="{{item.learned}}" class="ex-done">✓</text>
        </view>
        <view class="ex-stem clamp2 mt12">{{item.stem}}</view>
        <view class="row between mt12">
          <text class="tag tag-violet">{{item.tag}}</text>
          <text class="ex-go">看分步解析 →</text>
        </view>
      </view>
    </block>
    <view class="card empty" wx:else>
      <image class="empty-img" src="/assets/theme/s20.jpg" mode="aspectFit" />
      <view class="sub">本章例题在专题页里</view>
      <view class="muted mt8">每个专题都配了一道分步精讲例题</view>
      <view class="btn btn-soft btn-sm mt16" bindtap="setTab" data-k="topics">去看专题</view>
    </view>

    <view class="card-soft mt24">
      <view class="h3">本章自测</view>
      <view class="muted mt8">按本章知识点抽题，做完即时判分并记入错题本。</view>
      <view class="btn btn-primary btn-block mt16" bindtap="goQuiz">开始自测</view>
    </view>
  </block>

  <view class="safe-bottom"></view>
</view>

<!-- 弹层：例题 / 公式 -->
<view wx:if="{{sheet}}">
  <view class="mask" bindtap="closeSheet"></view>
  <view class="sheet">
    <view class="sheet-bar"></view>
    <view class="row between">
      <view class="grow">
        <view class="sheet-title ellipsis">{{sheet.title || sheet.name}}</view>
        <view class="muted">{{sheet.chName || (sheet.cat + ' · ' + ch.name)}}</view>
      </view>
      <view wx:if="{{sheet.isFormula}}" class="star {{sheet.fav ? 'on' : ''}}" bindtap="toggleFav">{{sheet.fav ? '★' : '☆'}}</view>
    </view>

    <scroll-view scroll-y class="sheet-scroll">
      <!-- 公式 -->
      <block wx:if="{{sheet.isFormula}}">
        <view class="formula-box mt20">
          <math src="{{sheet.math}}" size="{{40}}" />
        </view>
        <view class="sub mt16">{{sheet.desc}}</view>
        <view class="kv mt12">
          <text class="k">适用条件</text>
          <text class="v">{{sheet.cond}}</text>
        </view>
        <view class="kv mt8">
          <text class="k">易错提示</text>
          <text class="v">{{sheet.tip}}</text>
        </view>
        <view class="muted mt16">三合一复制</view>
        <view class="row wrap mt8">
          <view class="copy-btn" bindtap="copy" data-kind="text">纯文本</view>
          <view class="copy-btn" bindtap="copy" data-kind="latex">LaTeX</view>
          <view class="copy-btn" bindtap="copy" data-kind="matlab">MATLAB</view>
          <view class="copy-btn" bindtap="copy" data-kind="python">Python</view>
        </view>
        <view class="btn btn-primary btn-block mt24" wx:if="{{!sheet.learned}}" bindtap="markFormula">我已学会，记录进度</view>
        <view class="done-tip mt24" wx:else>✓ 已标记为已学</view>
      </block>

      <!-- 例题 -->
      <block wx:else>
        <view class="ex-stem-full mt16">{{sheet.stem}}</view>
        <view class="formula-box mt16" wx:if="{{sheet.math}}">
          <math src="{{sheet.math}}" size="{{34}}" />
        </view>
        <view class="step" wx:for="{{sheet.steps}}" wx:key="h">
          <view class="step-no">{{index + 1}}</view>
          <view class="grow">
            <view class="step-h">{{item.h}}</view>
            <view class="step-t">{{item.t}}</view>
          </view>
        </view>
        <view class="ans mt20">
          <text class="ans-k">答</text>
          <text class="ans-v">{{sheet.answer}}</text>
        </view>
        <view class="pit mt16">
          <text class="pit-k">易错</text>
          <text class="pit-v">{{sheet.pitfall}}</text>
        </view>
        <view class="btn btn-primary btn-block mt24" wx:if="{{!sheet.learned}}" bindtap="markExample">我已看懂，记录进度</view>
        <view class="done-tip mt24" wx:else>✓ 已标记为已学</view>
      </block>
    </scroll-view>
  </view>
</view>

<!-- 三级联动智能助教：桌宠悬挂 ⇄ 半屏伴读 ⇄ 全屏问答平台 -->
<assistant />
