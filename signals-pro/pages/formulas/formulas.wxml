<view class="page {{theme}}">
  <!-- 跨 tab 跳进来的来源提示：switchTab 没有返回栈，这里补一条可点的回路 -->
  <view class="back-bar" wx:if="{{back}}" bindtap="goBackTab">
    <text class="bb-arrow">‹</text>
    <text class="bb-t">返回{{back.label}}</text>
    <text class="bb-hint" wx:if="{{back.hint}}">{{back.hint}}</text>
  </view>

  <view class="head">
    <view class="grow">
      <view class="h1">公式库</view>
      <view class="sub mt8">{{counts.total}} 条 · 已学 {{counts.learned}} · 收藏 {{counts.fav}}</view>
    </view>
    <view class="fav-btn {{favOnly ? 'on' : ''}}" bindtap="toggleFavOnly">{{favOnly ? '★' : '☆'}}</view>
  </view>

  <!-- 变换对对碰小游戏入口 -->
  <view class="game-banner" bindtap="goMatchGame">
    <view class="gb-left">
      <view class="gb-title">🃏 变换对对碰 · 闪电消消乐</view>
      <view class="gb-sub">40秒时频配对挑战，快速认全经典变换对！</view>
    </view>
    <view class="gb-btn">开始挑战 ›</view>
  </view>

  <!-- 搜索 -->
  <view class="search">
    <text class="s-icon">⌕</text>
    <input
      class="s-input"
      value="{{q}}"
      placeholder="搜公式名 / 关键词 / 章节"
      placeholder-class="ph"
      confirm-type="search"
      bindinput="onSearch"
    />
    <text wx:if="{{q}}" class="s-x" bindtap="clearQ">×</text>
    <view class="s-filter {{filterOpen ? 'on' : ''}}" bindtap="toggleFilter">筛选</view>
  </view>

  <!-- 筛选面板 -->
  <view class="panel" wx:if="{{filterOpen}}">
    <view class="pn-t">按分类</view>
    <view class="row wrap">
      <view
        class="chip pn-chip {{cat === item ? 'chip-on' : ''}}"
        wx:for="{{cats}}"
        wx:key="*this"
        bindtap="setCat"
        data-v="{{item}}"
      >{{item}}</view>
    </view>
    <view class="pn-t mt16">按章节</view>
    <view class="row wrap">
      <view
        class="chip pn-chip {{ch === item.k ? 'chip-on' : ''}}"
        wx:for="{{chs}}"
        wx:key="k"
        bindtap="setCh"
        data-v="{{item.k}}"
      >{{item.t}}</view>
    </view>
    <view class="row between mt16">
      <text class="muted">当前 {{list.length}} 条结果</text>
      <text class="pn-reset" bindtap="resetFilter">重置筛选</text>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view class="fc card press" wx:for="{{list}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
      <view class="row between">
        <view class="row middle grow">
          <text class="fc-name ellipsis">{{item.name}}</text>
          <text wx:if="{{item.learned}}" class="fc-done">✓</text>
        </view>
        <view class="fc-star {{item.fav ? 'on' : ''}}" catchtap="toggleFav" data-id="{{item.id}}">{{item.fav ? '★' : '☆'}}</view>
      </view>
      <view class="fc-math">
        <math src="{{item.math}}" size="{{34}}" block />
      </view>
      <view class="row between mt12">
        <view class="row gap8">
          <text class="tag tag-blue">ch{{item.ch}}</text>
          <text class="tag">{{item.cat}}</text>
        </view>
        <text class="fc-go">详情</text>
      </view>
    </view>
  </view>

  <view class="card empty" wx:if="{{!list.length}}">
    <image class="empty-img" src="/assets/theme/s22.jpg" mode="aspectFit" />
    <view class="sub">{{favOnly ? '还没有收藏的公式' : '没有匹配的公式'}}</view>
    <view class="muted mt8">{{favOnly ? '点卡片右上角的星标即可收藏' : '换个关键词，或重置筛选条件'}}</view>
    <view class="btn btn-soft btn-sm mt16" bindtap="resetFilter">重置筛选</view>
  </view>

  <view class="footer-tip">公式 ID 与章节、专题互通，在知识点页点开的也是同一批公式</view>
  <view class="safe-bottom"></view>
</view>

<!-- 公式详情 -->
<view wx:if="{{sheet}}">
  <view class="mask" bindtap="close"></view>
  <view class="sheet">
    <view class="sheet-bar"></view>
    <view class="row between">
      <view class="grow">
        <view class="sheet-title">{{sheet.name}}</view>
        <view class="muted">ch{{sheet.ch}} · {{sheet.chName}} · {{sheet.cat}}</view>
      </view>
      <view class="star {{sheet.fav ? 'on' : ''}}" bindtap="toggleFav" data-id="{{sheet.id}}">{{sheet.fav ? '★' : '☆'}}</view>
    </view>

    <view class="formula-box mt20">
      <math src="{{sheet.math}}" size="{{42}}" block />
    </view>

    <scroll-view scroll-y class="sheet-scroll">
      <view class="sub mt16">{{sheet.desc}}</view>
      <view class="kv mt12">
        <text class="k">适用条件</text>
        <text class="v">{{sheet.cond}}</text>
      </view>
      <view class="kv mt8">
        <text class="k">易错提示</text>
        <text class="v">{{sheet.tip}}</text>
      </view>

      <view class="muted mt16">三合一复制（单段）</view>
      <view class="row wrap mt8">
        <view class="copy-btn" bindtap="copy" data-kind="text">纯文本</view>
        <view class="copy-btn" bindtap="copy" data-kind="latex">LaTeX</view>
        <view class="copy-btn" bindtap="copy" data-kind="matlab">MATLAB</view>
        <view class="copy-btn" bindtap="copy" data-kind="python">Python</view>
      </view>

      <view class="row gap16 mt8">
        <view class="btn btn-ghost grow" bindtap="goChapter">看所属章节</view>
        <view class="btn btn-soft grow" bindtap="copyAll">一键全复制</view>
      </view>

      <view class="btn btn-primary btn-block mt16" wx:if="{{!sheet.learned}}" bindtap="markLearned">我已学会，记录进度</view>
      <view class="done-tip mt16" wx:else>✓ 已标记为已学</view>
      <view class="safe-bottom"></view>
    </scroll-view>
  </view>
</view>

<!-- 三级联动智能助教：桌宠悬挂 ⇄ 半屏伴读 ⇄ 全屏问答平台 -->
<assistant />
