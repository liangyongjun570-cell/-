.head {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0 8rpx;
}
.fav-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--surface);
  box-shadow: var(--shadow);
  color: var(--ink-3);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.fav-btn.on {
  color: var(--butter);
  background: var(--butter-soft);
}

/* 变换对对碰入口卡 */
.game-banner {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius);
  background: linear-gradient(135deg, rgba(242, 105, 75, 0.12), rgba(255, 141, 110, 0.05));
  border: 2rpx solid rgba(242, 105, 75, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(242, 105, 75, 0.06);
}
.game-banner:active {
  transform: scale(0.985);
}
.gb-left {
  flex: 1;
  min-width: 0;
}
.gb-title {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--primary);
}
.gb-sub {
  font-size: 20rpx;
  color: var(--ink-2);
  margin-top: 4rpx;
}
.gb-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

/* 搜索 */
.search {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: var(--surface);
  border-radius: 999rpx;
  padding: 0 10rpx 0 26rpx;
  margin-top: 20rpx;
  box-shadow: var(--shadow);
}
.s-icon {
  font-size: 32rpx;
  color: var(--ink-3);
  margin-right: 14rpx;
}
.s-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
}
.ph { color: var(--ink-3); }
.s-x {
  width: 52rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--ink-3);
}
.s-filter {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 23rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.s-filter.on {
  background: var(--primary);
  color: #fff;
}

/* 筛选面板 */
.panel {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-top: 16rpx;
  box-shadow: var(--shadow);
}
.pn-t {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}
.pn-chip {
  margin-bottom: 12rpx;
}
.pn-reset {
  font-size: 23rpx;
  color: var(--primary);
  font-weight: 600;
}

/* 列表 */
.list {
  margin-top: 20rpx;
}
.fc {
  margin-bottom: 20rpx;
}
.fc-name {
  font-size: 29rpx;
  font-weight: 700;
  min-width: 0;
}
.fc-done {
  font-size: 22rpx;
  color: var(--mint);
  margin-left: 10rpx;
  flex-shrink: 0;
}
.fc-star {
  font-size: 34rpx;
  color: var(--ink-3);
  padding: 0 4rpx 0 16rpx;
  flex-shrink: 0;
}
.fc-star.on { color: var(--butter); }
.fc-math {
  background: var(--surface-2);
  border-radius: 18rpx;
  padding: 22rpx 18rpx;
  margin-top: 14rpx;
  display: flex;
  justify-content: center;
  overflow: hidden;
}
.fc-go {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 弹层 */
.formula-box {
  background: var(--surface-2);
  border-radius: 20rpx;
  padding: 26rpx 20rpx;
  display: flex;
  justify-content: center;
  overflow: hidden;
}
.sheet-scroll {
  max-height: 56vh;
  margin-top: 10rpx;
}
.star {
  font-size: 40rpx;
  color: var(--ink-3);
  padding: 0 8rpx;
}
.star.on { color: var(--butter); }
.kv {
  display: flex;
  align-items: flex-start;
}
.k {
  font-size: 22rpx;
  color: var(--ink-3);
  width: 120rpx;
  flex-shrink: 0;
}
.v {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.62;
}
.copy-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 22rpx;
  margin: 0 14rpx 14rpx 0;
}
.copy-btn:active { opacity: 0.7; }
.done-tip {
  text-align: center;
  font-size: 25rpx;
  color: var(--mint);
  font-weight: 600;
}
.footer-tip {
  margin-top: 24rpx;
  font-size: 21rpx;
  color: var(--ink-3);
  text-align: center;
  line-height: 1.7;
}
