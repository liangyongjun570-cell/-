/* ============ 登录 / 注册 / 找回密码 ============ */
.page.login {
  position: relative;
  padding: 0 40rpx calc(80rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

/* 背景柔光：纯 radial-gradient 做衰减，不用 filter，低版本也稳 */
.blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.b1 {
  width: 560rpx;
  height: 560rpx;
  top: -260rpx;
  right: -200rpx;
  background: radial-gradient(circle, rgba(242, 105, 75, 0.16), rgba(242, 105, 75, 0) 68%);
}
.b2 {
  width: 480rpx;
  height: 480rpx;
  top: 340rpx;
  left: -240rpx;
  background: radial-gradient(circle, rgba(239, 183, 91, 0.16), rgba(239, 183, 91, 0) 70%);
}
.dark .b1 {
  background: radial-gradient(circle, rgba(255, 139, 107, 0.12), rgba(255, 139, 107, 0) 68%);
}
.dark .b2 {
  background: radial-gradient(circle, rgba(240, 192, 105, 0.09), rgba(240, 192, 105, 0) 70%);
}

/* ============ 品牌区 ============ */
.brand {
  position: relative;
  z-index: 1;
  padding-top: 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo {
  padding: 10rpx;
  background: var(--surface);
  border-radius: 48rpx;
  box-shadow: 0 18rpx 44rpx rgba(125, 88, 62, 0.16);
}
.dark .logo {
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.45);
}
.brand-t {
  margin-top: 28rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 1rpx;
  color: var(--ink);
}
.brand-s {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--ink-3);
  text-align: center;
  padding: 0 20rpx;
}

/* ============ 微信一键登录 ============ */
.wxbox {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
}
.wxbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 999rpx;
  background: #07C160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1;
  box-shadow: 0 12rpx 28rpx rgba(7, 193, 96, 0.26);
}
.wxbtn::after {
  border: none;
}
.wxbtn.off {
  background: var(--surface-2);
  color: var(--ink-2);
  box-shadow: none;
  border: 2rpx solid var(--line);
}
.wxbtn[disabled] {
  opacity: 0.62;
}
.wxhint {
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--ink-3);
  padding: 0 20rpx;
}
.ordiv {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 30rpx 0 4rpx;
}
.ordiv .or-l {
  flex: 1;
  max-width: 120rpx;
}

/* ============ 表单卡 ============ */
.form {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  box-shadow: var(--shadow-lg);
}
.shake {
  animation: shake 0.4s ease;
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  18% { transform: translateX(-12rpx); }
  38% { transform: translateX(10rpx); }
  58% { transform: translateX(-7rpx); }
  78% { transform: translateX(4rpx); }
}

/* 分段控制（这一段原来点了没反应，现在两个标签都能切换） */
.seg {
  display: flex;
  background: var(--surface-2);
  border-radius: 22rpx;
  padding: 6rpx;
  margin-bottom: 8rpx;
}
.seg-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--ink-2);
  border-radius: 17rpx;
  transition: background 0.18s, color 0.18s;
}
.seg-item.on {
  background: var(--surface);
  color: var(--primary);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(125, 88, 62, 0.1);
}
.dark .seg-item.on {
  background: var(--primary-soft);
  box-shadow: none;
}

/* ============ 字段 ============ */
.fld {
  margin-top: 24rpx;
  padding: 14rpx 24rpx 12rpx;
  background: var(--surface-2);
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  box-sizing: border-box;
  transition: border-color 0.16s, background 0.16s;
}
.fld.on {
  background: var(--surface);
  border-color: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(242, 105, 75, 0.1);
}
.dark .fld.on {
  box-shadow: 0 0 0 6rpx rgba(255, 139, 107, 0.12);
}
.fld.bad {
  border-color: #D9534F;
  background: #FDECEA;
}
.dark .fld.bad {
  border-color: #FF8A7A;
  background: rgba(255, 139, 107, 0.1);
}
.fld-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 30rpx;
}
.fld-k {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.5rpx;
}
.fld-tip {
  font-size: 21rpx;
  color: #C0392B;
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dark .fld-tip {
  color: #FFB4A8;
}
.fld-tip.ok {
  color: var(--mint);
}
.fld-tip.st {
  color: var(--ink-3);
}
.fld-row {
  display: flex;
  align-items: center;
  margin-top: 2rpx;
}
.fld-i {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  font-size: 30rpx;
  color: var(--ink);
}
.ph {
  color: var(--ink-3);
  font-size: 27rpx;
}
.fld-x {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: var(--surface-3);
  color: var(--ink-3);
  font-size: 30rpx;
  line-height: 1;
  padding-bottom: 3rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.eye {
  flex: none;
  padding-left: 16rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}
.eye.on {
  color: var(--primary);
}

/* 密码强度 */
.st-bar {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 0 6rpx;
}
.st-i {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--surface-3);
  transition: background 0.2s;
}
.st-i.lv1 { background: #E8574A; }
.st-i.lv2 { background: var(--butter); }
.st-i.lv3 { background: var(--mint); }

/* ============ 密保（注册选填） ============ */
.sq {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--surface-2);
  border-radius: 22rpx;
}
.sq-head {
  display: flex;
  align-items: center;
}
.sq-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.sq-s {
  display: block;
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}
.sq-a {
  flex: none;
  margin-left: 16rpx;
  font-size: 23rpx;
  color: var(--primary);
  font-weight: 600;
}
.sq-picker {
  display: block;
}
.sq-pick {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  background: var(--surface);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.sq-arrow {
  margin-left: 12rpx;
  color: var(--ink-3);
}
.sq-fld {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  background: var(--surface);
  border-radius: 16rpx;
}

/* ============ 记住我 / 协议 ============ */
.opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}
.rmb {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}
.rmb-t {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
.cb {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.cb.sm {
  width: 30rpx;
  height: 30rpx;
  border-radius: 9rpx;
}
.cb.on {
  background: var(--primary);
  border-color: var(--primary);
}
/* 对勾用边框画，不依赖字库（部分安卓机型 ✕ / ✓ 会渲染成方框） */
.cb-t {
  display: none;
}
.cb.on .cb-t {
  display: block;
  width: 15rpx;
  height: 8rpx;
  margin-top: -4rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
}
.agree {
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
}
.agree-t {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.62;
}
.lnk {
  color: var(--primary);
}

/* ============ 找回密码步骤条 ============ */
.step {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}
.step-i {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--surface-3);
  color: var(--ink-3);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-i.on {
  background: var(--primary);
  color: #fff;
  font-weight: 700;
}
.step-l {
  width: 48rpx;
  height: 2rpx;
  margin: 0 10rpx;
  background: var(--line);
}
.step-t {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
.qbox {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--primary-soft);
  border-radius: 20rpx;
}
.q-k {
  display: block;
  font-size: 21rpx;
  color: var(--primary);
}
.q-t {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ============ 错误条 ============ */
.err {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 16rpx 20rpx;
  background: #FDECEA;
  border-radius: 16rpx;
}
.dark .err {
  background: rgba(255, 139, 107, 0.14);
}
.err-i {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #D9534F;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}
.dark .err-i {
  background: #FF8A7A;
  color: #2B1A15;
}
.err-t {
  flex: 1;
  font-size: 24rpx;
  color: #C0392B;
  line-height: 1.6;
}
.dark .err-t {
  color: #FFB4A8;
}

/* ============ 主按钮 ============ */
.submit {
  margin-top: 32rpx;
  height: 88rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
.spin {
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.42);
  border-top-color: #fff;
  animation: spin 0.7s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.switch-row {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ============ 游客入口 ============ */
.foot {
  position: relative;
  z-index: 1;
  margin-top: 44rpx;
}
.or-l {
  width: 84rpx;
  height: 2rpx;
  background: var(--line);
}
.or-t {
  font-size: 21rpx;
  color: var(--ink-3);
}
.guest {
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--primary);
}
.guest-sub {
  margin-top: 10rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  padding: 0 30rpx;
}

.notice {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
  padding: 0 24rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.8;
  color: var(--ink-3);
}

/* ============ 条款弹层 ============ */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(28, 19, 14, 0.45);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-radius: 36rpx 36rpx 0 0;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  animation: up 0.24s ease;
}
@keyframes up {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-x {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 32rpx;
}
.sheet-b {
  margin-top: 18rpx;
  max-height: 54vh;
}
.doc {
  font-size: 25rpx;
  line-height: 1.85;
  color: var(--ink-2);
  white-space: pre-wrap;
}
.sheet-btn {
  margin-top: 26rpx;
}
