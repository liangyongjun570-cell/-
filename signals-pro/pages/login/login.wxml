<view class="page no-tab login {{theme}}">
  <view class="blob b1"></view>
  <view class="blob b2"></view>

  <!-- ========== 品牌区 ========== -->
  <view class="brand">
    <view class="logo">
      <sticker name="s24" size="140" radius="38" />
    </view>
    <view class="brand-t">{{mode === 'login' ? '欢迎回来' : (mode === 'register' ? '创建本机账号' : '找回密码')}}</view>
    <view class="brand-s">
      {{mode === 'login' ? '登录后学习记录按账号独立保存' : (mode === 'register' ? '账号只存在这台设备，注册后自动登录' : '用注册时设下的密保问题重置')}}
    </view>
  </view>

  <!-- ========== 微信一键登录（静默取 openid，不弹授权框） ========== -->
  <view class="wxbox">
    <button
      class="wxbtn {{wxReady ? '' : 'off'}}"
      disabled="{{busy || wxBusy}}"
      bindtap="wxLogin"
      hover-class="none"
    >
      <view class="spin" wx:if="{{wxBusy}}"></view>
      <text>{{wxBusy ? '正在获取微信身份…' : '微信一键登录'}}</text>
    </button>
    <view class="wxhint" wx:if="{{wxHint}}">{{wxHint}}</view>

    <view class="ordiv">
      <view class="or-l"></view>
      <text class="or-t">或使用本机账号</text>
      <view class="or-l"></view>
    </view>
  </view>

  <!-- ========== 表单卡 ========== -->
  <view class="card form {{shake ? 'shake' : ''}}">
    <!-- 分段控制 -->
    <view class="seg" wx:if="{{mode !== 'reset'}}">
      <view class="seg-item {{mode === 'login' ? 'on' : ''}}" data-m="login" bindtap="switchMode">登录</view>
      <view class="seg-item {{mode === 'register' ? 'on' : ''}}" data-m="register" bindtap="switchMode">注册</view>
    </view>

    <!-- ---------- 登录 / 注册 ---------- -->
    <block wx:if="{{mode !== 'reset'}}">
      <!-- 账号 -->
      <view class="fld {{focus === 'account' ? 'on' : ''}} {{bad.account ? 'bad' : ''}}">
        <view class="fld-top">
          <text class="fld-k">账号</text>
          <text class="fld-tip" wx:if="{{bad.account}}">{{bad.account}}</text>
          <text class="fld-tip ok" wx:elif="{{mode === 'login' && last && account === last}}">上次登录</text>
        </view>
        <view class="fld-row">
          <input
            class="fld-i"
            value="{{account}}"
            maxlength="20"
            placeholder="4–20 位字母、数字或下划线"
            placeholder-class="ph"
            cursor-spacing="80"
            confirm-type="next"
            data-k="account"
            bindinput="onAccount"
            bindfocus="onFocus"
            bindblur="onBlur"
            bindconfirm="onConfirm"
          />
          <view class="fld-x" wx:if="{{account}}" catchtap="clearAcc">×</view>
        </view>
      </view>

      <!-- 密码 -->
      <view class="fld {{focus === 'pwd' ? 'on' : ''}} {{bad.pwd ? 'bad' : ''}}">
        <view class="fld-top">
          <text class="fld-k">密码</text>
          <text class="fld-tip" wx:if="{{bad.pwd}}">{{bad.pwd}}</text>
          <text class="fld-tip st" wx:elif="{{mode === 'register' && strength.text}}">{{strength.text}}</text>
        </view>
        <view class="fld-row">
          <input
            class="fld-i"
            password="{{!showPwd}}"
            value="{{pwd}}"
            maxlength="32"
            placeholder="{{mode === 'login' ? '请输入密码' : '8–32 位，含字母和数字'}}"
            placeholder-class="ph"
            cursor-spacing="80"
            confirm-type="{{mode === 'register' ? 'next' : 'done'}}"
            data-k="pwd"
            bindinput="onPwd"
            bindfocus="onFocus"
            bindblur="onBlur"
            bindconfirm="onConfirm"
          />
          <view class="eye {{showPwd ? 'on' : ''}}" catchtap="togglePwd">{{showPwd ? '隐藏' : '显示'}}</view>
        </view>
      </view>

      <!-- 密码强度条 -->
      <view class="st-bar" wx:if="{{mode === 'register' && pwd}}">
        <view class="st-i {{strength.lv >= 1 ? 'lv' + strength.lv : ''}}"></view>
        <view class="st-i {{strength.lv >= 2 ? 'lv' + strength.lv : ''}}"></view>
        <view class="st-i {{strength.lv >= 3 ? 'lv' + strength.lv : ''}}"></view>
      </view>

      <!-- 确认密码 -->
      <view class="fld {{focus === 'pwd2' ? 'on' : ''}} {{bad.pwd2 ? 'bad' : ''}}" wx:if="{{mode === 'register'}}">
        <view class="fld-top">
          <text class="fld-k">确认密码</text>
          <text class="fld-tip" wx:if="{{bad.pwd2}}">{{bad.pwd2}}</text>
        </view>
        <view class="fld-row">
          <input
            class="fld-i"
            password="{{!showPwd2}}"
            value="{{pwd2}}"
            maxlength="32"
            placeholder="再次输入密码"
            placeholder-class="ph"
            cursor-spacing="80"
            confirm-type="done"
            data-k="pwd2"
            bindinput="onPwd2"
            bindfocus="onFocus"
            bindblur="onBlur"
            bindconfirm="onConfirm"
          />
          <view class="eye {{showPwd2 ? 'on' : ''}}" catchtap="togglePwd2">{{showPwd2 ? '隐藏' : '显示'}}</view>
        </view>
      </view>

      <!-- 密保（注册选填） -->
      <view class="sq" wx:if="{{mode === 'register'}}">
        <view class="sq-head" bindtap="toggleSq">
          <view class="grow">
            <text class="sq-t">密保问题</text>
            <text class="sq-s">忘记密码时，本机唯一的找回方式</text>
          </view>
          <text class="sq-a {{sqOpen ? 'on' : ''}}">{{sqOpen ? '收起' : '设置'}}</text>
        </view>

        <view class="sq-body" wx:if="{{sqOpen}}">
          <picker class="sq-picker" mode="selector" range="{{sqList}}" value="{{sqIndex}}" bindchange="onSq">
            <view class="sq-pick">
              <text class="grow ellipsis">{{sqList[sqIndex]}}</text>
              <text class="sq-arrow">›</text>
            </view>
          </picker>
          <view class="sq-fld">
            <input
              class="fld-i"
              value="{{sqAnswer}}"
              maxlength="30"
              placeholder="填写答案（不区分大小写）"
              placeholder-class="ph"
              cursor-spacing="80"
              bindinput="onSqAnswer"
            />
          </view>
        </view>
      </view>

      <!-- 记住我 / 忘记密码 -->
      <view class="opt" wx:if="{{mode === 'login'}}">
        <view class="rmb" bindtap="toggleRemember">
          <view class="cb sm {{remember ? 'on' : ''}}"><view class="cb-t"></view></view>
          <text class="rmb-t">记住我</text>
        </view>
        <text class="lnk" bindtap="goReset">忘记密码？</text>
      </view>

      <!-- 协议（注册必勾） -->
      <view class="agree" wx:if="{{mode === 'register'}}" bindtap="toggleAgree">
        <view class="cb {{agree ? 'on' : ''}}"><view class="cb-t"></view></view>
        <view class="agree-t">
          我已阅读并同意
          <text class="lnk" data-k="terms" catchtap="openDoc">《用户协议》</text>
          <text>与</text>
          <text class="lnk" data-k="privacy" catchtap="openDoc">《隐私说明》</text>
        </view>
      </view>
    </block>

    <!-- ---------- 找回密码 ---------- -->
    <block wx:else>
      <view class="step">
        <view class="step-i {{resetStep >= 1 ? 'on' : ''}}"><text>1</text></view>
        <view class="step-l"></view>
        <view class="step-i {{resetStep >= 2 ? 'on' : ''}}"><text>2</text></view>
        <text class="step-t">{{resetStep === 1 ? '确认账号' : '验证密保并重置'}}</text>
      </view>

      <view class="fld {{focus === 'raccount' ? 'on' : ''}} {{bad.account ? 'bad' : ''}}">
        <view class="fld-top">
          <text class="fld-k">账号</text>
          <text class="fld-tip" wx:if="{{bad.account}}">{{bad.account}}</text>
        </view>
        <view class="fld-row">
          <input
            class="fld-i"
            value="{{resetAcc}}"
            maxlength="20"
            placeholder="输入要找回的账号"
            placeholder-class="ph"
            cursor-spacing="80"
            confirm-type="done"
            bindinput="onResetAcc"
            bindfocus="onFocus"
            bindblur="onBlur"
            bindconfirm="resetQuery"
          />
        </view>
      </view>

      <block wx:if="{{resetStep === 2}}">
        <view class="qbox">
          <text class="q-k">密保问题</text>
          <text class="q-t">{{resetQ}}</text>
        </view>

        <view class="fld {{bad.answer ? 'bad' : ''}}">
          <view class="fld-top">
            <text class="fld-k">答案</text>
            <text class="fld-tip" wx:if="{{bad.answer}}">{{bad.answer}}</text>
          </view>
          <view class="fld-row">
            <input
              class="fld-i"
              value="{{resetAnswer}}"
              maxlength="30"
              placeholder="不区分大小写"
              placeholder-class="ph"
              cursor-spacing="80"
              bindinput="onResetAnswer"
            />
          </view>
        </view>

        <view class="fld {{bad.pwd ? 'bad' : ''}}">
          <view class="fld-top">
            <text class="fld-k">新密码</text>
            <text class="fld-tip" wx:if="{{bad.pwd}}">{{bad.pwd}}</text>
          </view>
          <view class="fld-row">
            <input
              class="fld-i"
              password="{{!resetShow}}"
              value="{{resetPwd1}}"
              maxlength="32"
              placeholder="8–32 位，含字母和数字"
              placeholder-class="ph"
              cursor-spacing="80"
              bindinput="onResetPwd1"
            />
            <view class="eye {{resetShow ? 'on' : ''}}" catchtap="toggleResetShow">{{resetShow ? '隐藏' : '显示'}}</view>
          </view>
        </view>

        <view class="fld {{bad.pwd2 ? 'bad' : ''}}">
          <view class="fld-top">
            <text class="fld-k">确认新密码</text>
            <text class="fld-tip" wx:if="{{bad.pwd2}}">{{bad.pwd2}}</text>
          </view>
          <view class="fld-row">
            <input
              class="fld-i"
              password="{{!resetShow}}"
              value="{{resetPwd2}}"
              maxlength="32"
              placeholder="再次输入新密码"
              placeholder-class="ph"
              cursor-spacing="80"
              confirm-type="done"
              bindinput="onResetPwd2"
              bindconfirm="submitReset"
            />
          </view>
        </view>
      </block>
    </block>

    <!-- 错误条 -->
    <view class="err" wx:if="{{err}}">
      <text class="err-i">!</text>
      <text class="err-t">{{err}}</text>
    </view>

    <!-- 主按钮 -->
    <button
      wx:if="{{mode !== 'reset'}}"
      class="btn btn-primary btn-block submit"
      disabled="{{busy}}"
      bindtap="submit"
    >
      <view class="spin" wx:if="{{busy}}"></view>
      <text>{{busy ? busyText : (mode === 'login' ? '登 录' : '注册并登录')}}</text>
    </button>

    <button wx:elif="{{resetStep === 1}}" class="btn btn-primary btn-block submit" bindtap="resetQuery">
      <text>下一步</text>
    </button>

    <button wx:else class="btn btn-primary btn-block submit" disabled="{{busy}}" bindtap="submitReset">
      <view class="spin" wx:if="{{busy}}"></view>
      <text>{{busy ? busyText : '重置密码'}}</text>
    </button>

    <!-- 底部切换 -->
    <view class="switch-row" wx:if="{{mode === 'login'}}" bindtap="switchMode" data-m="register">
      还没有账号？<text class="lnk">立即注册</text>
    </view>
    <view class="switch-row" wx:elif="{{mode === 'register'}}" bindtap="switchMode" data-m="login">
      已有账号？<text class="lnk">返回登录</text>
    </view>
    <view class="switch-row" wx:else bindtap="backToLogin">
      <text class="lnk">‹ 返回登录</text>
    </view>
  </view>

  <!-- ========== 游客入口 ========== -->
  <view class="foot">
    <view class="guest" bindtap="guest">先随便逛逛 · 以游客身份体验</view>
    <view class="guest-sub">游客的学习记录只留在这台设备，之后登录可以一并带入</view>
  </view>

  <view class="notice">
    游客数据只保存在本机；登录后学习记录会同步到云端，用于换设备继续。换机或清理缓存前，建议先在「我的」里导出备份。
  </view>

  <!-- ========== 条款弹层 ========== -->
  <view class="mask" wx:if="{{docOpen}}" bindtap="closeDoc">
    <view class="sheet" catchtap="noop">
      <view class="sheet-h">
        <text class="h3">{{docTitle}}</text>
        <text class="sheet-x" bindtap="closeDoc">×</text>
      </view>
      <scroll-view scroll-y class="sheet-b">
        <text class="doc">{{docBody}}</text>
      </scroll-view>
      <view class="btn btn-primary btn-block sheet-btn" bindtap="closeDoc">我知道了</view>
    </view>
  </view>
</view>
