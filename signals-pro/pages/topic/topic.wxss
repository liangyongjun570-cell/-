/* 头部 */
.th {
  padding: 24rpx 0 8rpx;
}
.th-ch {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
  background: var(--primary-soft);
  color: var(--primary);
  flex-shrink: 0;
}
.thc-blue { background: var(--blue-soft); color: #4E7FB5; }
.thc-mint { background: var(--mint-soft); color: #3F8F6B; }
.thc-butter { background: var(--butter-soft); color: #A8752A; }
.thc-violet { background: var(--violet-soft); color: #6E5CA8; }
.thc-pink { background: var(--pink-soft); color: #C26666; }
.thc-coral { background: var(--primary-soft); color: var(--primary); }
.th-cn {
  font-size: 23rpx;
  color: var(--ink-2);
  max-width: 320rpx;
}
.th-arrow {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-left: 6rpx;
}
.ico {
  font-size: 38rpx;
  color: var(--ink-3);
  padding: 0 6rpx;
}
.ico.on { color: var(--butter); }
.th-name {
  font-size: 48rpx;
  font-weight: 800;
  margin-top: 16rpx;
  line-height: 1.28;
  letter-spacing: 0.5rpx;
}
.th-done {
  font-size: 18rpx;
  background: var(--mint-soft);
  color: #3F8F6B;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 14rpx;
}
.th-intro {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.72;
  background: var(--surface-2);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
}

/* Tabs */
.tabs {
  white-space: nowrap;
  margin-top: 24rpx;
}
.tab {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 25rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
}
.tab.on {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  border-color: var(--primary);
}

/* 概述卡 */
.ov-abbr {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
}
.ov-row {
  display: flex;
  align-items: flex-start;
}
.ov-k {
  width: 130rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}
.ov-v {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
}
.rc {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.rc:last-child { border-bottom: none; }
.rc-t {
  font-size: 27rpx;
  font-weight: 600;
}

/* 段落 */
.sec {
  margin-top: 32rpx;
}
.sec-h {
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
  padding-left: 20rpx;
  position: relative;
  margin-bottom: 12rpx;
}
.sec-h::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--primary-2), var(--primary));
}
.p {
  font-size: 27rpx;
  line-height: 1.82;
  color: var(--ink);
  margin-top: 12rpx;
  text-align: justify;
}
.ul {
  margin-top: 12rpx;
}
.li {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
}
.li-d {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--primary);
  margin: 16rpx 14rpx 0 4rpx;
  flex-shrink: 0;
}
.li-t {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-2);
}
.mathbox {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-top: 18rpx;
  display: flex;
  justify-content: center;
  overflow-x: auto;
}
.flow {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fl-node {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  font-size: 25rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  color: var(--ink);
}
.fl-arrow {
  font-size: 24rpx;
  color: var(--ink-3);
  margin: 6rpx 0;
}

/* 公式 */
.fm {
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.fm:last-child { border-bottom: none; }
.fm-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.fm-math {
  background: var(--surface-2);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  justify-content: center;
  overflow-x: auto;
}
.fm-go {
  font-size: 21rpx;
  color: var(--primary);
  margin-top: 10rpx;
}

/* 例题 */
.ex-tag {
  font-size: 18rpx;
  font-weight: 700;
  background: var(--violet-soft);
  color: #6E5CA8;
  border-radius: 8rpx;
  padding: 3rpx 12rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.ex-title {
  font-size: 28rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
}
.ex-stem {
  font-size: 26rpx;
  line-height: 1.78;
}
.hint-box {
  background: var(--blue-soft);
  border-radius: 16rpx;
  padding: 18rpx;
}
.hint-k {
  font-size: 21rpx;
  font-weight: 700;
  color: #4E7FB5;
  margin-right: 12rpx;
}
.hint-v {
  font-size: 24rpx;
  color: #3C6693;
  line-height: 1.65;
}
.step {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
}
.step-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.step-h {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}
.step-t {
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.72;
}
.ans {
  background: var(--mint-soft);
  border-radius: 18rpx;
  padding: 20rpx;
}
.ans-k {
  font-size: 22rpx;
  font-weight: 700;
  color: #3F8F6B;
  margin-right: 14rpx;
}
.ans-v {
  font-size: 26rpx;
  color: #2F7154;
  font-weight: 600;
  line-height: 1.65;
}
.pit {
  background: var(--butter-soft);
  border-radius: 18rpx;
  padding: 20rpx;
}
.pit-k {
  font-size: 22rpx;
  font-weight: 700;
  color: #A8752A;
  margin-right: 14rpx;
}
.pit-v {
  font-size: 24rpx;
  color: #8A5F20;
  line-height: 1.65;
}

/* 随堂测 */
.qz-q {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
}
.qz-opt-wrap {
  margin-top: 16rpx;
}
.qz-opt {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
}
.qz-opt:active { opacity: 0.8; }
.qz-opt.right {
  background: var(--mint-soft);
  border-color: var(--mint);
}
.qz-opt.wrong {
  background: var(--pink-soft);
  border-color: var(--pink);
}
.qz-k {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.qz-v {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.55;
}
.qz-exp {
  background: var(--surface-2);
  border-radius: 14rpx;
  padding: 16rpx;
  margin-top: 4rpx;
}
.qz-exp-k {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6rpx;
}
.qz-exp-v {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.65;
}

/* 应用 */
.case-tag {
  display: inline-block;
  font-size: 19rpx;
  font-weight: 700;
  background: var(--primary-soft);
  color: var(--primary);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.case-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}
.case-desc {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.8;
  text-align: justify;
}
.note-view {
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.75;
  background: var(--surface-2);
  border-radius: 14rpx;
  padding: 18rpx;
  white-space: pre-wrap;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  box-shadow: 0 -8rpx 30rpx rgba(125, 88, 62, 0.09);
}
.bottom-holder {
  height: 130rpx;
}
.bb-star {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--surface-2);
  color: var(--ink-3);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bb-star.on {
  color: var(--butter);
  background: var(--butter-soft);
}
.bb-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--primary-2), var(--primary));
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(242, 105, 75, 0.26);
}
.bb-btn.done {
  background: var(--mint-soft);
  color: #3F8F6B;
  box-shadow: none;
}
.bb-next {
  height: 76rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  color: var(--ink-2);
  font-size: 25rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 笔记 / 弹层 */
.note-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 220rpx;
  background: var(--surface-2);
  border-radius: 18rpx;
  padding: 22rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
}
.ph { color: var(--ink-3); }
.formula-box {
  background: var(--surface-2);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: center;
  overflow-x: auto;
}
.sheet-scroll {
  max-height: 58vh;
  margin-top: 8rpx;
}
.star {
  font-size: 40rpx;
  color: var(--ink-3);
  padding: 0 8rpx;
}
.star.on { color: var(--butter); }
.kv {
  display: flex;
  align-items: flex-start;
}
.k {
  font-size: 22rpx;
  color: var(--ink-3);
  width: 120rpx;
  flex-shrink: 0;
}
.v {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.62;
}
.copy-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 22rpx;
  margin: 0 14rpx 14rpx 0;
}
.copy-btn:active { opacity: 0.7; }
.done-tip {
  text-align: center;
  font-size: 25rpx;
  color: var(--mint);
  font-weight: 600;
}

.arrow {
  font-size: 34rpx;
  color: var(--ink-3);
  margin-left: 12rpx;
}
