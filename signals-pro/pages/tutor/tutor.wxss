.tut {
  height: 100vh;
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* 模式条 */
.modes {
  white-space: nowrap;
  padding: 20rpx 0 8rpx;
  flex-shrink: 0;
}
.mode {
  display: inline-flex;
  align-items: center;
  height: 62rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  margin-right: 12rpx;
}
.mode.on {
  background: var(--primary);
  border-color: var(--primary);
}
.md-ic {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}
.mode.on .md-ic {
  background: rgba(255, 255, 255, 0.26);
  color: #fff;
}
.md-nm {
  font-size: 23rpx;
  color: var(--ink-2);
}
.mode.on .md-nm {
  color: #fff;
  font-weight: 600;
}

/* 对话区 */
.chat {
  flex: 1;
  min-height: 0;
  padding: 8rpx 0 0;
}
.chat-pad {
  height: 24rpx;
}

.hot {
  margin: 18rpx 0 6rpx;
}
.hot-t {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}
.hot-q {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow);
}
.hot-q:active { opacity: 0.85; }
.hq-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--primary);
  margin-right: 14rpx;
  flex-shrink: 0;
}
.hq-t {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}
.hq-go {
  font-size: 30rpx;
  color: var(--ink-3);
}
.th-chip {
  margin-bottom: 12rpx;
}

/* 消息 */
.msg {
  margin: 16rpx 0;
}
.u-row {
  display: flex;
  justify-content: flex-end;
}
.u-bubble {
  max-width: 78%;
  background: linear-gradient(135deg, var(--primary-2), var(--primary));
  color: #fff;
  font-size: 26rpx;
  line-height: 1.65;
  padding: 18rpx 22rpx;
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  box-shadow: 0 6rpx 16rpx rgba(242, 105, 75, 0.2);
}

.b-row {
  display: flex;
  align-items: flex-start;
}
.b-ava {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  background: var(--surface-2);
  flex-shrink: 0;
}
.b-card {
  flex: 1;
  min-width: 0;
  background: var(--surface);
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  padding: 22rpx;
  box-shadow: var(--shadow);
}
.b-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 10rpx;
}
.b-text {
  font-size: 26rpx;
  line-height: 1.72;
  color: var(--ink);
  white-space: pre-wrap;
}
.b-p {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink);
  margin-top: 12rpx;
  text-align: justify;
}
.b-step {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
}
.bs-no {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.bs-t {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.72;
  color: var(--ink-2);
}
.b-quote {
  margin-top: 12rpx;
  background: var(--surface-2);
  border-left: 6rpx solid var(--violet);
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.b-ans {
  margin-top: 14rpx;
  background: var(--mint-soft);
  border-radius: 16rpx;
  padding: 16rpx;
}
.ba-k {
  font-size: 21rpx;
  font-weight: 700;
  color: #3F8F6B;
  margin-right: 12rpx;
}
.ba-v {
  font-size: 25rpx;
  color: #2F7154;
  font-weight: 600;
  line-height: 1.65;
}
.b-tip {
  margin-top: 14rpx;
  background: var(--butter-soft);
  border-radius: 16rpx;
  padding: 16rpx;
}
.bt-k {
  font-size: 21rpx;
  font-weight: 700;
  color: #A8752A;
  margin-right: 12rpx;
}
.bt-v {
  font-size: 24rpx;
  color: #8A5F20;
  line-height: 1.65;
}
.b-fm {
  margin-top: 14rpx;
  background: var(--surface-2);
  border-radius: 16rpx;
  padding: 16rpx;
}
.b-fm:active { opacity: 0.8; }
.bf-name {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}
.bf-math {
  display: flex;
  justify-content: center;
  overflow-x: auto;
}
.bf-go {
  font-size: 19rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* 输入栏 */
.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0 8rpx;
  border-top: 2rpx solid var(--line);
  background: var(--bg);
}
.ib-clear {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 2rpx solid var(--line);
  color: var(--ink-3);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ib-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  background: var(--surface);
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
  color: var(--ink);
  box-shadow: var(--shadow);
}
.ph { color: var(--ink-3); }
.ib-send {
  height: 78rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--primary-2), var(--primary));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(242, 105, 75, 0.26);
}
