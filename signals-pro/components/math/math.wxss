.mw {
  width: 100%;
  white-space: nowrap;
}
.m-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
  white-space: nowrap;
  line-height: 1.5;
  color: inherit;
  padding: 2rpx 0;
}
.m-t {
  white-space: pre;
  font-family: "Times New Roman", "Songti SC", serif;
  letter-spacing: 0.3rpx;
}
.m-sup {
  font-size: 0.62em;
  line-height: 1;
  align-self: flex-start;
  margin-top: -0.1em;
  font-family: "Times New Roman", "Songti SC", serif;
}
.m-sub {
  font-size: 0.62em;
  line-height: 1;
  align-self: flex-end;
  margin-bottom: 0.1em;
  font-family: "Times New Roman", "Songti SC", serif;
}
.m-frac {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.12;
  margin: 0 6rpx;
}
.m-part {
  font-size: 0.86em;
  padding: 0 2rpx;
  font-family: "Times New Roman", "Songti SC", serif;
}
.m-bar {
  height: 2rpx;
  width: 100%;
  min-width: 26rpx;
  background: currentColor;
  opacity: 0.75;
}
.m-big {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 2rpx;
}
.m-glyph {
  font-size: 1.62em;
  line-height: 0.86;
  font-family: "Times New Roman", serif;
}
.m-limits {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.1;
  margin-left: 1rpx;
}
.m-lim-sup {
  font-size: 0.5em;
  font-family: "Times New Roman", "Songti SC", serif;
}
.m-lim-sub {
  font-size: 0.5em;
  font-family: "Times New Roman", "Songti SC", serif;
}
.m-lim-word {
  font-size: 0.9em;
  font-style: italic;
}
.m-sqrt {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 0 2rpx;
}
.m-rad {
  font-size: 1.05em;
  line-height: 1.1;
}
.m-rad-body {
  border-top: 2rpx solid currentColor;
  padding: 0 4rpx;
  margin-top: 4rpx;
  font-size: 0.92em;
}
